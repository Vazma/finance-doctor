rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the emails in config/access (written with admin credentials, never by the app) can use the app.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/access).data.emails;
    }
    function isOwner(uid) {
      return allowed() && request.auth.uid == uid;
    }

    match /config/access {
      allow read: if allowed();
      allow write: if false;
    }

    // Personal space: only its owner can read or write, the partner included.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Shared space: both members read and write; each member edits only their own member doc (income).
    match /households/{householdId} {
      allow read, write: if allowed();
      match /members/{uid} {
        allow read: if allowed();
        allow write: if isOwner(uid);
      }
      match /{collection}/{docId} {
        allow read, write: if allowed() && collection != 'members';
      }
    }
  }
}
