rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }
    function householdDoc(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }
    function inviteDoc(code) {
      return /databases/$(database)/documents/invites/$(code);
    }
    function isMember(hid) {
      return signedIn() && me() in get(householdDoc(hid)).data.members;
    }
    function isMemberAfter(hid) {
      return signedIn() && me() in getAfter(householdDoc(hid)).data.members;
    }

    // Personal space: only its owner, the partner included.
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
      match /{collection}/{docId} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    match /households/{hid} {
      function joiningWithInvite() {
        let code = request.resource.data.joinedWith;
        let invite = get(inviteDoc(code)).data;
        return !(me() in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinedWith'])
          && request.resource.data.members == resource.data.members.concat([me()])
          && invite.householdId == hid
          && invite.usedBy == null
          && invite.expiresAt > request.time
          && getAfter(inviteDoc(code)).data.usedBy == me();
      }

      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members == [me()]
        && request.resource.data.createdBy == me();
      allow update: if signedIn() && (
        (me() in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy)
        || joiningWithInvite()
      );

      // Each member's public profile + income (needed for the split); only the owner edits it.
      match /members/{uid} {
        allow read: if isMember(hid);
        allow write: if isMemberAfter(hid) && me() == uid;
      }
      match /{collection}/{docId} {
        allow read, write: if isMember(hid) && collection != 'members';
      }
    }

    // Single-use invite links. The code is random, so `get` by code is enough; no listing.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == me()
        && request.resource.data.usedBy == null
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == me()
        && me() in getAfter(householdDoc(resource.data.householdId)).data.members;
      allow delete: if signedIn() && resource.data.createdBy == me();
    }
  }
}
